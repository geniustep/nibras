{
  "framework": "nextjs",
  "buildCommand": "npm run build:vercel",
  "redirects": [
    {
      "source": "/",
      "destination": "/ar",
      "permanent": false
    },
    {
      "source": "/admission",
      "destination": "/ar/admission",
      "permanent": false
    },
    {
      "source": "/admission/:path*",
      "destination": "/ar/admission/:path*",
      "permanent": false
    },
    {
      "source": "/tassjil",
      "destination": "/ar/admission",
      "permanent": true
    },
    {
      "source": "/tassjil/:path*",
      "destination": "/ar/admission/:path*",
      "permanent": true
    },
    {
      "source": "/adminsession",
      "destination": "https://admission.madarisnibras.ma/admin",
      "permanent": false
    },
    {
      "source": "/adminsession/:path*",
      "destination": "https://admission.madarisnibras.ma/admin/:path*",
      "permanent": false
    },
    {
      "source": "/:locale(ar|fr|en)/adminsession",
      "destination": "https://admission.madarisnibras.ma/admin",
      "permanent": false
    },
    {
      "source": "/:locale(ar|fr|en)/adminsession/:path*",
      "destination": "https://admission.madarisnibras.ma/admin/:path*",
      "permanent": false
    }
  ]
}
