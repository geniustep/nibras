generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdmissionRequestStatus {
  NEW
  IN_REVIEW
  CONTACT_REQUIRED
  APPOINTMENT_SCHEDULED
  MISSING_DOCUMENTS
  PRE_ACCEPTED
  FINAL_REGISTERED
  INCOMPLETE
  WAITING_LIST
  CANCELLED
}

enum SchoolCycle {
  EARLY_CHILDHOOD
  PRIMARY
  MIDDLE_SCHOOL
  HIGH_SCHOOL
}

enum SchoolLevel {
  AGE_3
  AGE_4
  AGE_5
  PRIMARY_1
  PRIMARY_2
  PRIMARY_3
  PRIMARY_4
  PRIMARY_5
  PRIMARY_6
  MIDDLE_1
  MIDDLE_2
  MIDDLE_3
  COMMON_CORE
}

enum CommonCoreTrack {
  SCIENTIFIC
  LITERARY
  TECHNOLOGICAL
}

enum Gender {
  MALE
  FEMALE
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  ADMISSION_STAFF
  VIEWER
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  REJECTED
}

enum NoteVisibility {
  INTERNAL
  PARENT_VISIBLE
}

enum AppointmentType {
  VISIT
  INTERVIEW
  PHONE_CALL
  DOCUMENTS
}

enum AppointmentStatus {
  SCHEDULED
  DONE
  CANCELLED
  MISSED
}

enum ActivityEntityType {
  ADMISSION_REQUEST
  INTERNAL_NOTE
  APPOINTMENT
  USER
}

enum ActivityAction {
  STATUS_CHANGED
  ASSIGNED
  NOTE_ADDED
  APPOINTMENT_CREATED
  APPOINTMENT_UPDATED
  APPOINTMENT_CANCELLED
  REQUEST_UPDATED
  REQUEST_VIEWED
  EXPORT_REQUESTS
}

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  phone        String?
  role         UserRole   @default(ADMISSION_STAFF)
  status       UserStatus @default(PENDING)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  assignedRequests     AdmissionRequest[]      @relation("AssignedRequests")
  statusChanges        RequestStatusHistory[]
  notes                InternalNote[]
  appointmentsCreated  AdmissionAppointment[]  @relation("AppointmentCreator")
  activityLogs         ActivityLog[]

  @@index([role])
  @@index([status])
}

model ApplicationCounter {
  id    String @id @default("default")
  year  Int
  value Int    @default(0)
}

model AdmissionRequest {
  id             String                 @id @default(cuid())
  trackingNumber String                 @unique
  status         AdmissionRequestStatus @default(NEW)

  studentFirstName   String
  studentLastName    String
  studentDateOfBirth DateTime
  studentGender      Gender
  studentNationalId  String?
  currentSchool      String?
  studentNotes       String?

  parentFullName     String
  parentPhone        String
  parentWhatsapp     String?
  parentEmail        String?
  parentAddress      String?
  parentMessage      String?

  schoolCycle     SchoolCycle
  schoolLevel     SchoolLevel
  commonCoreTrack CommonCoreTrack?

  needsTransport  Boolean        @default(false)
  transportNotes  String?
  needsCanteen    Boolean        @default(false)

  assignedToId String?
  assignedTo   AdminUser? @relation("AssignedRequests", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusHistory RequestStatusHistory[]
  notes         InternalNote[]
  appointments  AdmissionAppointment[]
  activityLogs  ActivityLog[]

  @@index([status])
  @@index([schoolCycle])
  @@index([schoolLevel])
  @@index([assignedToId])
  @@index([createdAt])
  @@map("Application")
}

model RequestStatusHistory {
  id                 String                  @id @default(cuid())
  admissionRequestId String                  @map("applicationId")
  admissionRequest   AdmissionRequest        @relation(fields: [admissionRequestId], references: [id], onDelete: Cascade)
  oldStatus          AdmissionRequestStatus?   @map("fromStatus")
  newStatus          AdmissionRequestStatus    @map("toStatus")
  changedById        String?
  changedBy          AdminUser?              @relation(fields: [changedById], references: [id], onDelete: SetNull)
  note               String?
  createdAt          DateTime                @default(now())

  @@index([admissionRequestId])
  @@map("StatusHistory")
}

model InternalNote {
  id                 String         @id @default(cuid())
  admissionRequestId String         @map("applicationId")
  admissionRequest   AdmissionRequest @relation(fields: [admissionRequestId], references: [id], onDelete: Cascade)
  authorId           String
  author             AdminUser      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content            String
  visibility         NoteVisibility @default(INTERNAL)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([admissionRequestId])
}

model AdmissionAppointment {
  id                 String            @id @default(cuid())
  admissionRequestId String
  admissionRequest   AdmissionRequest  @relation(fields: [admissionRequestId], references: [id], onDelete: Cascade)
  scheduledAt        DateTime
  type               AppointmentType
  status             AppointmentStatus @default(SCHEDULED)
  note               String?
  createdById        String
  createdBy          AdminUser         @relation("AppointmentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([admissionRequestId])
  @@index([scheduledAt])
}

model ActivityLog {
  id          String             @id @default(cuid())
  userId      String
  user        AdminUser          @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      ActivityAction
  entityType  ActivityEntityType
  entityId    String
  description String
  metadata    Json?
  createdAt   DateTime           @default(now())

  admissionRequestId String?
  admissionRequest   AdmissionRequest? @relation(fields: [admissionRequestId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([admissionRequestId])
  @@index([createdAt])
}
